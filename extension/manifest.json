{
  "manifest_version": 2,
  "name": "BálnaSkip – Súlytalan reklámskip",
  "short_name": "BálnaSkip",
  "version": "1.1.0",
  "description": "A Súlytalan videók elején felismeri a „Bálna, te súlytalan…” trigger mondatot, és átdobja a reklámot.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "shared/core.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "shared/core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "BálnaSkip",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_area": "navbar"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "balnaskip@sulytalan.local",
      "strict_min_version": "115.0"
    }
  }
}
