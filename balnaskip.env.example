# BálnaSkip helyi build-beállítások / local build settings
#
# Másold át balnaskip.env néven, majd írd be a saját útvonalaidat:
#   copy balnaskip.env.example balnaskip.env
#
# A balnaskip.env nincs verziókövetve (lásd .gitignore), így minden gép a saját
# útvonalait használhatja. A folyamatkörnyezetben beállított ugyanilyen nevű
# változók felülírják a fájlban lévő értékeket.
#
# A relatív útvonalak a repository gyökeréhez képest értendők. Windows-os
# útvonalhoz használj / elválasztót vagy \\-t.

# A extension/ mappa abszolút útvonala (itt van a manifest.json).
BALNASKIP_EXTENSION_DIR=C:/Users/yourname/Documents/BalnaSkip/extension

# A kész .xpi célmappája.
BALNASKIP_DIST_DIR=C:/Users/yourname/Documents/BalnaSkip/dist
